<wpf:FramelessWindowEx x:Class="NodeCraft.MainWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:wpf="clr-namespace:CommonControls.WPF;assembly=CommonControls.WPF"
                       FontFamily="{DynamicResource Wqy-zenhei}"
                       Title="NodeCraft — Visual Flow Editor"
                       Height="720"
                       Width="1200"
                       Closed="MainWindow_Closed"
                       Loaded="MainWindow_Loaded">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="文件">
                <MenuItem Header="新建" Click="MenuNewGraph_Click" />
                <MenuItem Header="清空" Click="MenuClearGraph_Click" />
                <Separator />
                <MenuItem Header="加载" Click="MenuLoadGraph_Click" />
                <MenuItem Header="保存" Click="MenuSaveGraph_Click" />
                <MenuItem Header="另存为" Click="MenuSaveGraphAs_Click" />
                <Separator />
                <MenuItem Header="退出" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="流程">
                <MenuItem Header="校验" Click="MenuValidateGraph_Click" />
                <MenuItem Header="执行" Click="MenuRunGraph_Click" />
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem x:Name="DarkThemeMenuItem"
                          Header="深色主题"
                          IsCheckable="True"
                          Checked="DarkThemeMenuItem_Checked"
                          Unchecked="DarkThemeMenuItem_Unchecked" />
            </MenuItem>
        </Menu>
    </Grid>
</wpf:FramelessWindowEx>

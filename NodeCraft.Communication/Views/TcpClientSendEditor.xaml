<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="230">
    <Border Padding="8"
            CornerRadius="8"
            Background="{DynamicResource colorSubtleBackground}"
            BorderBrush="{DynamicResource colorNeutralStroke1}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="TCP Client Send"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource colorNeutralForeground1}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Host"
                       Foreground="{DynamicResource colorNeutralForeground3}"
                       Margin="0,0,0,3" />
            <TextBox x:Name="HostEditor"
                     Margin="0,0,0,6" />
            <TextBlock Text="Port"
                       Foreground="{DynamicResource colorNeutralForeground3}"
                       Margin="0,0,0,3" />
            <TextBox x:Name="PortEditor"
                     Margin="0,0,0,6" />
            <TextBlock Text="Connect timeout (ms)"
                       Foreground="{DynamicResource colorNeutralForeground3}"
                       Margin="0,0,0,3" />
            <TextBox x:Name="ConnectTimeoutEditor"
                     Margin="0,0,0,6" />
            <CheckBox x:Name="StopOnSendFailureEditor"
                      Content="Stop execution when sending fails" />
        </StackPanel>
    </Border>
</UserControl>

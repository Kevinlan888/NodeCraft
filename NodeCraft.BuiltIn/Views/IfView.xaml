<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NodeCraft.Localization;assembly=NodeCraft.Flow"
             MinWidth="180">
    <Border Padding="8" CornerRadius="8" Background="{DynamicResource colorSubtleBackground}"
            BorderBrush="{DynamicResource colorNeutralStroke1}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="IF" Text="IF" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource colorNeutralForeground1}" Margin="0,4,0,8" />
            <TextBlock x:Name="TrueLabel" Text="{l:Loc FlowPort_true}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource colorStatusSuccessForeground1}" Margin="0,0,0,4" />
            <TextBlock x:Name="FalseLabel" Text="{l:Loc FlowPort_false}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource colorStatusDangerForeground1}" Margin="0,0,0,4" />
        </StackPanel>
    </Border>
</UserControl>

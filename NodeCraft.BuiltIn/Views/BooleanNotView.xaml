<UserControl x:Class="NodeCraft.BuiltIn.Views.BooleanNotView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200">
    <Border Padding="8" CornerRadius="8" Background="{DynamicResource colorSubtleBackground}"
            BorderBrush="{DynamicResource colorNeutralStroke1}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="!A" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource colorNeutralForeground1}" Margin="0,4,0,6" />
            <TextBlock Text="反转布尔输入" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource colorNeutralForeground3}" Margin="0,0,0,8" />
            <TextBlock x:Name="InputValue" Text="未连接" TextWrapping="Wrap"
                       Foreground="{DynamicResource colorNeutralForeground2}" Margin="0,0,0,4" />
        </StackPanel>
    </Border>
</UserControl>

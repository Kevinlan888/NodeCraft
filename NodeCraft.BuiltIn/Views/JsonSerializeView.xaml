<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200">
    <Border Padding="8"
            CornerRadius="8"
            Background="{DynamicResource colorSubtleBackground}"
            BorderBrush="{DynamicResource colorNeutralStroke1}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="JSON"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource colorNeutralForeground1}"
                       Margin="0,0,0,4" />
            <TextBlock Text="将任意输入格式化为多行 JSON"
                       Foreground="{DynamicResource colorNeutralForeground3}"
                       Margin="0,0,0,6" />
            <TextBlock x:Name="InputValue"
                       Text="未连接"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource colorNeutralForeground2}" />
        </StackPanel>
    </Border>
</UserControl>

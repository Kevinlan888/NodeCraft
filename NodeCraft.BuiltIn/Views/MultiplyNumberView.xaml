<UserControl x:Class="NodeCraft.BuiltIn.Views.MultiplyNumberView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="210">
    <Border Padding="8"
            CornerRadius="8"
            Background="{DynamicResource colorSubtleBackground}"
            BorderBrush="{DynamicResource colorNeutralStroke1}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="A * B"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource colorNeutralForeground1}"
                       Margin="0,4,0,6" />
            <TextBlock Grid.Row="1"
                       Text="输出两个数字输入的乘积"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource colorNeutralForeground3}"
                       Margin="0,0,0,8" />
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="A" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock x:Name="InputAValue" Grid.Column="1" Text="未连接" TextWrapping="Wrap"
                           Foreground="{DynamicResource colorNeutralForeground2}" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock x:Name="InputBValue" Grid.Column="1" Text="未连接" TextWrapping="Wrap"
                           Foreground="{DynamicResource colorNeutralForeground2}" />
            </Grid>
            <Button x:Name="SwapInputsButton" Grid.Row="4" Content="Swap A/B"
                    HorizontalAlignment="Stretch" Padding="8,5" Margin="0,4,0,0" />
        </Grid>
    </Border>
</UserControl>

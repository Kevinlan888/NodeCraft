<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <StereoCameraPackageRoot Condition="'$(StereoCameraPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\Plugins\NodeCraft.Vision.StereoCamera</StereoCameraPackageRoot>
  </PropertyGroup>

  <Target Name="StageStereoCameraPlugin" DependsOnTargets="Build">
    <Error Condition="'$(StereoCameraSdkRoot)' == ''"
           Text="StereoCameraSdkRoot must point to the vendor SDK root when staging the StereoCamera plugin." />

    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)StereoCameraRuntimeFiles.txt">
      <Output TaskParameter="Lines" ItemName="_StereoCameraRuntimeFileName" />
    </ReadLinesFromFile>

    <ItemGroup>
      <_StereoCameraRuntimeSource Include="$(StereoCameraSdkRoot)\Runtime\x64\%(_StereoCameraRuntimeFileName.Identity)" />
      <_StereoCameraRootRuntimeName Include="msvcp120.dll" />
      <_StereoCameraRootRuntimeName Include="msvcr120.dll" />
      <_StereoCameraRootRuntimeName Include="oxylog.toml" />
      <_StereoCameraRootRuntimeSource Include="$(StereoCameraSdkRoot)\%(_StereoCameraRootRuntimeName.Identity)" />
      <_StereoCameraLicenseFile Include="$(StereoCameraSdkRoot)\Licenses\**\*" />

      <_MissingStereoCameraSdkFile Include="%(_StereoCameraRuntimeSource.Identity)"
          Condition="!Exists('%(_StereoCameraRuntimeSource.Identity)')" />
      <_MissingStereoCameraSdkFile Include="%(_StereoCameraRootRuntimeSource.Identity)"
          Condition="!Exists('%(_StereoCameraRootRuntimeSource.Identity)')" />
      <_MissingStereoCameraSdkFile Include="$(StereoCameraSdkRoot)\Licenses"
          Condition="!Exists('$(StereoCameraSdkRoot)\Licenses')" />
    </ItemGroup>

    <Error Condition="'@(_MissingStereoCameraSdkFile)' != ''"
           Text="StereoCamera SDK is missing required files: @(_MissingStereoCameraSdkFile)" />
    <Error Condition="!Exists('$(TargetPath)')"
           Text="StereoCamera plugin assembly was not built: $(TargetPath)" />
    <Error Condition="$([System.String]::Copy('@(_StereoCameraRuntimeFileName)').Contains('StereoCamera.Net.dll'))"
           Text="StereoCamera runtime manifest must exclude StereoCamera.Net.dll." />
    <Error Condition="$([System.String]::Copy('@(_StereoCameraRuntimeFileName)').Contains('NLog.dll'))"
           Text="StereoCamera runtime manifest must exclude vendor NLog.dll." />
    <Error Condition="$([System.String]::Copy('@(_StereoCameraRuntimeFileName)').Contains('NodeCraft.Flow.dll'))"
           Text="StereoCamera package must exclude NodeCraft.Flow.dll." />
    <Error Condition="$([System.String]::Copy('@(_StereoCameraRuntimeFileName)').Contains('CommonControls.WPF.dll'))"
           Text="StereoCamera package must exclude CommonControls.WPF.dll." />
    <Error Condition="$([System.String]::Copy('@(_StereoCameraRuntimeFileName)').Contains('Microsoft.Extensions.Logging'))"
           Text="StereoCamera package must exclude Microsoft logging assemblies." />

    <RemoveDir Directories="$(StereoCameraPackageRoot)" />
    <MakeDir Directories="$(StereoCameraPackageRoot);$(StereoCameraPackageRoot)\lib;$(StereoCameraPackageRoot)\licenses" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\plugin.json"
          DestinationFolder="$(StereoCameraPackageRoot)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(StereoCameraPackageRoot)" />
    <Copy SourceFiles="@(_StereoCameraRuntimeSource)"
          DestinationFolder="$(StereoCameraPackageRoot)\lib" />
    <Copy SourceFiles="@(_StereoCameraRootRuntimeSource)"
          DestinationFolder="$(StereoCameraPackageRoot)\lib" />
    <Copy SourceFiles="@(_StereoCameraLicenseFile)"
          DestinationFiles="@(_StereoCameraLicenseFile->'$(StereoCameraPackageRoot)\licenses\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>

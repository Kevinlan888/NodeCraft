<UserControl x:Class="NodeCraft.Vision.StereoCamera.Views.StereoCameraEditor"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="190">
    <Border Padding="8"
            CornerRadius="8"
            Background="{DynamicResource colorSubtleBackground}"
            BorderBrush="{DynamicResource colorNeutralStroke1}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Stereo Camera"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource colorNeutralForeground1}"
                       Margin="0,0,0,6" />
            <TextBlock Text="IPv4 address"
                       Foreground="{DynamicResource colorNeutralForeground3}"
                       Margin="0,0,0,3" />
            <TextBox x:Name="IpAddressEditor" />
        </StackPanel>
    </Border>
</UserControl>

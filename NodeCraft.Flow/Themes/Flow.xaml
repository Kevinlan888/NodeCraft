<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:flow="clr-namespace:NodeCraft.Flow"
                    xmlns:local="clr-namespace:CommonControls.WPF;assembly=CommonControls.WPF"
                    xmlns:converters="clr-namespace:CommonControls.WPF.Converters;assembly=CommonControls.WPF"
                    xmlns:l="clr-namespace:NodeCraft.Localization">
    <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ════════════════════════════════════════════════════════════
         FlowCanvas (Flow namespace)
         ════════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type flow:FlowCanvas}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type flow:FlowCanvas}">
                    <Border Name="OuterNode"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <AdornerDecorator>
                            <Grid x:Name="CanvasViewport" Background="Transparent" ClipToBounds="True" AllowDrop="True">
                                <Canvas x:Name="CanFlow"
                                        Width="10000"
                                        Height="10000"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        AllowDrop="True" />
                            </Grid>
                        </AdornerDecorator>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════
         NodeView (Flow namespace)
         ════════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type flow:NodeView}">
        <Setter Property="Background" Value="{DynamicResource colorNeutralBackground1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource colorBrandForeground1}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type flow:NodeView}">
                    <Border Name="OuterNode" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource cornerRadiusMedium}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="InputSocketsPanel" Grid.Row="1" Grid.Column="0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,2,0" />
                            <StackPanel x:Name="OutputSocketsPanel" Grid.Row="1" Grid.Column="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2,0,0,0" />

                            <Grid Name="InnerNode" Grid.Row="1" Grid.Column="1" Background="Transparent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <Thumb x:Name="ResizeThumb" Grid.Row="2" Grid.Column="2" Width="12" Height="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Visibility="{TemplateBinding IsResizable, Converter={StaticResource BoolToVis}}"
                                   Cursor="SizeNWSE" IsTabStop="False">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Width="10" Height="10" CornerRadius="2"
                                                Background="{DynamicResource colorSubtleBackgroundHover}"
                                                BorderBrush="{DynamicResource colorNeutralStroke1}" BorderThickness="1"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════
         Connector (Flow namespace)
         ════════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type flow:Connector}">
        <Setter Property="Background" Value="{DynamicResource colorBrandStroke1}" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type flow:Connector}">
                    <Border x:Name="Border"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Ellipse x:Name="Round" Fill="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Round" Property="Fill" Value="{DynamicResource colorStrokeFocus2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════
         FlowNodePalette (Flow namespace + CommonControls.WPF)
         ════════════════════════════════════════════════════════════ -->

    <Style x:Key="FlowPaletteExpanderStyle" TargetType="{x:Type Expander}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource colorNeutralForeground1}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      HorizontalContentAlignment="Stretch"
                                      Foreground="{TemplateBinding Foreground}"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      BorderThickness="0"
                                      Padding="8,6"
                                      Margin="0,4,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:PackIcon Kind="{Binding IconKind}"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource colorNeutralForeground1}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Path x:Name="Chevron"
                                      Grid.Column="2"
                                      Width="10"
                                      Height="10"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource colorNeutralForeground1}"
                                      StrokeThickness="2"
                                      Data="M1,1 L5,5 L9,1" />
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite"
                                          Visibility="Collapsed"
                                          Margin="0,0,0,4" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type flow:FlowNodePaletteItem}">
        <flow:DraggableButton Tag="{Binding TypeKey}"
                              Width="84"
                              Height="78"
                              Margin="0,0,8,8"
                              Padding="6"
                              ToolTip="{Binding Description}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Background="Transparent"
                              HoveredBackground="{DynamicResource colorSubtleBackgroundHover}"
                              PressedBackground="{DynamicResource colorSubtleBackgroundPressed}">
            <StackPanel HorizontalAlignment="Center">
                <local:PackIcon Kind="{Binding IconKind}"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource colorNeutralForeground1}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding DisplayName}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           local:Typography.Level="LabelMedium" />
            </StackPanel>
        </flow:DraggableButton>
    </DataTemplate>

    <Style TargetType="{x:Type flow:FlowNodePalette}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type flow:FlowNodePalette}">
                    <Border Padding="4"
                            CornerRadius="{DynamicResource cornerRadiusXLarge}"
                            Background="{DynamicResource colorNeutralBackground1}"
                            BorderBrush="{DynamicResource colorNeutralStroke1}"
                            BorderThickness="1">
                        <Grid x:Name="PART_Root">
                            <StackPanel>
                                <ItemsControl ItemsSource="{TemplateBinding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type flow:FlowNodePaletteCategory}">
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      Style="{StaticResource FlowPaletteExpanderStyle}">
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
